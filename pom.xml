<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.sty</groupId>
    <artifactId>PalindromZahlen</artifactId>
    <version>1.0.1</version>
    <inceptionYear>2024</inceptionYear>

    <description>
        Sucht zu einer Zahl ihre Palindrom-Zahl
        (Zahlen, die von vorne wie von hinten gleich sind, beispielsweise 1221, 1234321, ...),
        indem zur Zahl ihre Spiegelzahl addiert wird
        (12 --> 12 + 21 = 33, 83 --> 82 + 28 = 110, 110 + 011 = 121).
    </description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <build>
        <plugins>

            <plugin>
                <!-- Start/Main-Klasse angeben -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>PalindromZahl</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <!--
                 Ein shaded/über/fat-JAR bauen, in dem alle Abhängigkeiten enthalten sind,
                 sodass es einfach gestartet werden kann.
                 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>PalindromZahl</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Wenn GraalVM genutzt wird, ein native binary bauen, dass auch ohne JRE läuft -->
            <id>native-image-compatible</id>
            <activation>
                <!-- Detect GraalVM -->
                <property>
                    <name>java.vendor</name>
                    <value>Oracle Corporation</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.nativeimage</groupId>
                        <artifactId>native-image-maven-plugin</artifactId>
                        <version>21.2.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>native-image</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <buildArgs>
                                <arg>-Ob</arg>
                                <arg>-march=native</arg>
                            </buildArgs>
                            <!-- Yes, it is in the root package -->
                            <mainClass>PalindromZahl</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <scm>
        <url>https://github.com/stuelten/PalindromZahlen.git</url>
        <connection>scm:git:git://github.com/stuelten/PalindromZahlen.git</connection>
    </scm>

    <developers>
        <developer>
            <id>stuelten</id>
            <name>Timo Stülten</name>
            <email>timo.stuelten@googlemail.com</email>
        </developer>
    </developers>

</project>
